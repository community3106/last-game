# Nostr Relays (カンマ区切り)
NOSTR_RELAYS=wss://relay.damus.io,wss://nos.lol,wss://relay.nostr.band
# 管理者ホワイトリスト (hex pubkey, カンマ区切り) — ここに含まれる鍵のみ /admin にアクセス可
ADMIN_PUBKEYS=ede8d8c3b2e3e3e3e3e3e3e3e3e3e3e3e3e3e3e3e3e3e3e3e3e3e3e3e3e3e3e3
# 有料会員リストの Nostr kind (parameterized replaceable)
PAID_LIST_KIND=30078
# NIP-44 推奨、NIP-04 フォールバック
ENCRYPTION=nip44

# Stripe
STRIPE_PUBLISHABLE_KEY=pk_test_51xxxxxxxxxxxxxxxx
STRIPE_SECRET_KEY=sk_test_51xxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_1xxxxxxxxxxxxxxxx
STRIPE_PRICE_PREMIUM=price_1Premium980
STRIPE_PRICE_GOD=price_1God2980
# 開発モック (true で Stripe をスキップし Nostr へ直接登録)
MOCK_STRIPE=true

# Cloudflare Pages
CLOUDFLARE_API_TOKEN=your_cf_api_token_here
CLOUDFLARE_ACCOUNT_ID=your_cf_account_id_here
